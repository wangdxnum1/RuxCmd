{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RuxCmd Desktop",
  "identifier": "io.github.wangdxnum1.ruxcmd-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RuxCmd Desktop",
        "width": 960,
        "height": 700,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
